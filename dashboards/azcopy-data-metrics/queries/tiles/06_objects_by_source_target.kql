// Visual: Bar chart
let QueryStart = _startTime;
let QueryEnd = _endTime;
{{ENRICHED_FINISHED_JOBS}}
{{ENRICHMENT_FILTERS}}
FilteredFinishedJobs
| extend SourceTargetPair = strcat(SourceType, ' -> ', DestType)
| summarize EstimatedObjects = sum(Weight * ObjectsCompleted) by SourceTargetPair
| project SourceTargetPair, EstimatedCompletedObjects = round(EstimatedObjects, 0)
| order by EstimatedCompletedObjects desc
