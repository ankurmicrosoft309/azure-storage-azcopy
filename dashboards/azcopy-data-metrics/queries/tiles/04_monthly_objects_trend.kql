// Visual: Time chart
let QueryStart = _startTime;
let QueryEnd = _endTime;
{{ENRICHED_FINISHED_JOBS}}
{{ENRICHMENT_FILTERS}}
FilteredFinishedJobs
| summarize EstimatedObjects = sum(Weight * ObjectsCompleted) by timestamp = startofmonth(EndTime)
| project timestamp, EstimatedCompletedObjects = round(EstimatedObjects, 0)
| order by timestamp asc
