// Visual: Bar chart
let QueryStart = _startTime;
let QueryEnd = _endTime;
{{ENRICHED_FINISHED_JOBS}}
{{ENRICHMENT_FILTERS}}
FilteredFinishedJobs
| summarize EstimatedBytes = sum(Weight * BytesTransferred) by DestType
| project DestinationType = DestType, EstimatedDataTB = round(EstimatedBytes / 1000000000000.0, 3)
| order by EstimatedDataTB desc
