// Visual: Time chart
customMetrics
| where timestamp between (_startTime .. _endTime)
| where tostring(customDimensions.ServiceName) == 'azcopy'
| where name in ('azcopy.storage_http_attempt_count', 'azcopy.network_error_attempt_count', 'azcopy.failure_error_other_count')
| summarize Attempts = sum(value) by bin(timestamp, 1h), Metric = name
| order by timestamp asc