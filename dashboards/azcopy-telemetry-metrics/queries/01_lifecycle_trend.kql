// Visual: Time chart
// Raw observed telemetry values; no inverse-sampling estimation.
customMetrics
| where timestamp between (_startTime .. _endTime)
| where tostring(customDimensions.ServiceName) == 'azcopy'
| where name in ('azcopy.command.invoked', 'azcopy.job.started', 'azcopy.job.finished')
| summarize Value = sum(value) by bin(timestamp, 1h), Metric = name
| order by timestamp asc