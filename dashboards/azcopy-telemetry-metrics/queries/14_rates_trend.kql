// Visual: Time chart
customMetrics
| where timestamp between (_startTime .. _endTime)
| where tostring(customDimensions.ServiceName) == 'azcopy'
| where name in ('azcopy.server_busy_pct', 'azcopy.network_error_pct', 'azcopy.percent_complete')
| summarize AveragePct = avg(value) by bin(timestamp, 1h), Metric = name
| order by timestamp asc