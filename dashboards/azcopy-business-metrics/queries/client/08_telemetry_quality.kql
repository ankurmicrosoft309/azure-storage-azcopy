// Visual: Multi stat
// Schema v2 finish attempts are expected to contain 50 distinct finish metrics.
customMetrics
| where timestamp between (_startTime .. _endTime)
| where tostring(customDimensions.ServiceName) == 'azcopy'
| extend
    InvocationID = tostring(customDimensions.InvocationID),
    SamplingRateValue = todouble(customDimensions.SamplingRate),
    SchemaVersionValue = tostring(customDimensions.SchemaVersion),
    SourceTypeValue = tostring(customDimensions.SourceType),
    DestTypeValue = tostring(customDimensions.DestType),
    SourceAccountValue = tostring(customDimensions.SourceStorageAccount),
    DestAccountValue = tostring(customDimensions.DestStorageAccount),
    SourceEndpointValue = tostring(customDimensions.SourceEndpointIdentity),
    DestEndpointValue = tostring(customDimensions.DestEndpointIdentity)
| where isnotempty(InvocationID) and name != 'azcopy.command.invoked'
| summarize
    StartedRows = countif(name == 'azcopy.job.started'),
    FinishedRows = countif(name == 'azcopy.job.finished'),
    FinishMetricNames = dcountif(name, name != 'azcopy.job.started'),
    SamplingRate = max(SamplingRateValue),
    SchemaVersion = take_any(SchemaVersionValue),
    SourceType = take_any(SourceTypeValue),
    DestType = take_any(DestTypeValue),
    SourceAccount = take_any(SourceAccountValue),
    DestAccount = take_any(DestAccountValue),
    SourceEndpoint = take_any(SourceEndpointValue),
    DestEndpoint = take_any(DestEndpointValue)
  by InvocationID
| extend
    MissingSourceIdentity = SourceType !in ('', 'Local', 'Benchmark', 'Pipe', 'None') and isempty(SourceAccount) and isempty(SourceEndpoint),
    MissingDestIdentity = DestType !in ('', 'Local', 'Benchmark', 'Pipe', 'None') and isempty(DestAccount) and isempty(DestEndpoint)
| summarize
    ObservedAttempts = count(),
    UnmatchedStarts = countif(StartedRows > 0 and FinishedRows == 0),
    FinishWithoutStart = countif(FinishedRows > 0 and StartedRows == 0),
    IncompleteV2Finishes = countif(FinishedRows > 0 and SchemaVersion == '2' and FinishMetricNames < 50),
    MissingSamplingRate = countif(isnull(SamplingRate) or SamplingRate <= 0.0),
    MissingRemoteIdentity = countif(MissingSourceIdentity or MissingDestIdentity),
    SchemaVersions = make_set(SchemaVersion, 10)